# Database connection — use Supabase Transaction Pooler URL (port 6543) for production
DATABASE_URL="postgresql://postgres.[PROJECT_ID]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase project URL and service role key (for file uploads)
SUPABASE_URL="https://[PROJECT_ID].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# API authentication key — required for all write operations
API_SECRET_KEY="change-this-to-a-strong-random-string"

# (Optional) Restrict CORS to your frontend domain in production
# CORS_ORIGIN="https://your-frontend.vercel.app"

# Server port (default: 3001)
# PORT=3001
